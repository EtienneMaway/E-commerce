{
  "expo": {
    "name": "KMB-Talk",
    "slug": "trading-app",
    "version": "1.0.0",
    "scheme": "kmb-app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF1FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kmb.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kmb.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#D3CEFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      "./plugins/with-cleartext-local",
      "./plugins/with-brand-colors",
      "./plugins/with-bt-no-location"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e13f95c5-e462-4ab6-9fc7-6beb8a1946f5"
      }
    },
    "owner": "etienne_mw",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e13f95c5-e462-4ab6-9fc7-6beb8a1946f5"
    }
  }
}
